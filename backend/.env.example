# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database Configuration (PostgreSQL or local fallback)
# Production PostgreSQL example: postgresql://postgres:postgres@localhost:5432/yatrashare
DATABASE_URL=sqlite://./yatrashare.db

# Authentication Secrets
JWT_ACCESS_SECRET=yatrashare_jwt_access_secret_production_ready_key_12345
JWT_REFRESH_SECRET=yatrashare_jwt_refresh_secret_production_ready_key_67890
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Payment Gateway Configuration (MOCK | RAZORPAY | STRIPE)
PAYMENT_GATEWAY_DEFAULT=MOCK
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email / Notification Configuration
EMAIL_PROVIDER=MOCK
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="YatraShare <noreply@yatrashare.com>"

# Map & Routing Configuration (OSM | GOOGLE | MAPBOX)
MAP_PROVIDER=OSM
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=
